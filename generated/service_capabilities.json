{
  "note": "pkt_core.builder.Lab authors topology, power, modules, cabling, IOS config, end-device IP and wireless. It has NO method for DHCP/DNS/HTTP/HTTPS/SMTP/POP3/FTP/AAA services; those are authored by editing the device <ENGINE> XML directly. pkt_core.models + pkt_core.audit provide typed read views and uniqueness validation for the records.",
  "builder_lab_methods": [
    "add_device",
    "device_names",
    "drop_initial",
    "drop_seed_devices",
    "initial_id",
    "install_module",
    "link",
    "prune_seed_devices",
    "save",
    "set_config_register",
    "set_os",
    "set_wireless"
  ],
  "builder_covers": {
    "ios_config": "add_device(ios_config=[...])",
    "pc_ip": "add_device(pc_ip=(ip,mask,gw))",
    "wireless": "set_wireless(...)"
  },
  "library_counted_families": [
    "aaa_clients",
    "aaa_users",
    "dhcp_pools",
    "dns_records",
    "ftp_accounts"
  ],
  "services": {
    "dhcp": {
      "xml_structure": {
        "server_container_path": "ENGINE/DHCP_SERVERS/ASSOCIATED_PORTS/ASSOCIATED_PORT/DHCP_SERVER/POOLS/POOL",
        "homerouter_container_path": "ENGINE/DHCP_SERVER/POOLS/POOL",
        "enable_flag": "ENGINE/DHCP_SERVERS/.../DHCP_SERVER/ENABLED (1|0)",
        "record_tag": "POOL",
        "identity_fields": [
          "NAME",
          "NETWORK",
          "MASK"
        ],
        "pool_fields_observed": [
          "NAME",
          "NETWORK",
          "MASK",
          "DEFAULT_ROUTER",
          "TFTP_ADDRESS",
          "START_IP",
          "END_IP",
          "DNS_SERVER",
          "MAX_USERS",
          "DOMAIN_NAME",
          "DHCP_POOL_LEASES",
          "LEASE_TIME",
          "WLC_ADDRESS"
        ],
        "view_fields": [
          "DEFAULT_ROUTER",
          "DHCP_POOL_LEASES",
          "DNS_SERVER",
          "DOMAIN_NAME",
          "END_IP",
          "LEASE_TIME",
          "MASK",
          "MAX_USERS",
          "NAME",
          "NETWORK",
          "START_IP",
          "TFTP_ADDRESS",
          "WLC_ADDRESS"
        ],
        "server_skeleton": {
          "DHCP_SERVERS": {
            "ASSOCIATED_PORTS": {
              "ASSOCIATED_PORT": {
                "NAME": "FastEthernet0",
                "DHCP_SERVER": {
                  "ENABLED": "0",
                  "POOLS": {
                    "_children": [
                      "POOL"
                    ]
                  },
                  "DHCP_RESERVATIONS": ""
                }
              }
            }
          }
        },
        "runtime_only": [
          "DHCP_POOL_LEASES",
          "DHCP_RESERVATIONS"
        ]
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": "pkt_core.models.services.DhcpPool",
      "validation": "pkt_core.audit.validate_lab -> duplicate-dhcp-pool/-name/-scope"
    },
    "dns": {
      "xml_structure": {
        "container_path": "ENGINE/DNS_SERVER/NAMESERVER-DATABASE/RESOURCE-RECORD",
        "enable_flag": "ENGINE/DNS_SERVER/ENABLED (1|0)",
        "record_tag": "RESOURCE-RECORD",
        "identity_fields": [
          "TYPE",
          "NAME",
          "IPADDRESS"
        ],
        "view_fields": [
          "IPADDRESS",
          "NAME",
          "TTL",
          "TYPE"
        ],
        "server_skeleton": {
          "DNS_SERVER": {
            "ENABLED": "1",
            "NAMESERVER-DATABASE": ""
          }
        },
        "note": "A record's zone key is (TYPE, NAME); replication across servers is legitimate."
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": "pkt_core.models.services.DnsRecord",
      "validation": "pkt_core.audit.validate_lab -> duplicate-dns-record (per server zone)"
    },
    "http": {
      "xml_structure": {
        "enable_block": "ENGINE/HTTP_SERVER (ENABLED, USERNAME, PASSWORD)",
        "https_block": "ENGINE/HTTPS_SERVER",
        "page_store_path": "ENGINE/FILE_MANAGER/FILE/FILES/FILE[NAME='http:']/FILES/FILE",
        "page_fields": [
          "FILE_NUMBER",
          "NAME",
          "DATE_TIME",
          "PERMISSION",
          "FILE_CONTENT"
        ],
        "default_pages": [
          "copyrights.html",
          "helloworld.html",
          "image.html",
          "index.html"
        ],
        "server_skeleton": {
          "HTTP_SERVER": {
            "ENABLED": "1",
            "USERNAME": "",
            "PASSWORD": ""
          }
        },
        "note": "Web page bodies live in the simulated 'http:' filesystem, not inside <HTTP_SERVER>."
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": "pkt_core.models.schema.FileEntry (page bodies)",
      "validation": null
    },
    "email": {
      "xml_structure": {
        "server_block": "ENGINE/EMAIL_SERVER",
        "server_skeleton": {
          "EMAIL_SERVER": {
            "SMTP_ENABLED": "1",
            "SMTP_DOMAIN": "",
            "POP3_ENABLED": "1",
            "FORWARD_MAIL": "0",
            "NO_OF_USERS": "0"
          }
        },
        "enable_flags": [
          "SMTP_ENABLED (1|0)",
          "POP3_ENABLED (1|0)"
        ],
        "domain_field": "SMTP_DOMAIN",
        "user_count_field": "NO_OF_USERS",
        "account_path": "ENGINE/EMAIL_SERVER/USERS/USER (NAME, PASSWORD)",
        "client_block": "ENGINE/EMAIL_CLIENT",
        "note": "Templates ship 0 accounts; USERS/USER records are authored directly."
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": null,
      "validation": null
    },
    "ftp": {
      "xml_structure": {
        "container_path": "ENGINE/FTP_SERVER/USER_ACCOUNT_MNGR/ACCOUNT",
        "enable_flag": "ENGINE/FTP_SERVER/ENABLED (1|0)",
        "identity_fields": [
          "USERNAME"
        ],
        "view_fields": [
          "PASSWORD",
          "PERMISSIONS",
          "USERNAME"
        ],
        "server_skeleton": {
          "FTP_SERVER": {
            "ENABLED": "1",
            "USER_ACCOUNT_MNGR": {
              "ACCOUNT": {
                "USERNAME": "cisco",
                "PASSWORD": "cisco",
                "PERMISSIONS": "RWDNL"
              }
            }
          }
        }
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": "pkt_core.models.services.FtpAccount",
      "validation": "pkt_core.audit.validate_lab -> duplicate-ftp-account"
    },
    "aaa": {
      "xml_structure": {
        "server_block": "ENGINE/ACS_SERVER",
        "users_path": "ENGINE/ACS_SERVER/USERS/USER",
        "clients_path": "ENGINE/ACS_SERVER/ACS_CLIENTS/CLIENT",
        "user_identity_fields": [
          "NAME"
        ],
        "client_identity_fields": [
          "HOST_IP"
        ],
        "server_skeleton": {
          "ACS_SERVER": {
            "ENABLED": "1",
            "USERS": {
              "USER": {
                "NAME": "user",
                "PASSWORD": "cisco",
                "DESCRIPTION": ""
              }
            },
            "ACS_CLIENTS": {
              "CLIENT": {
                "HOST_IP": "192.168.10.1",
                "KEY": "ciscosecret",
                "DESCRIPTION": "R1",
                "SERVER_TYPE": "RADIUS"
              }
            },
            "RADIUS_SETTINGS": {
              "AUTH_PORT": "1645"
            }
          }
        }
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": "pkt_core.models.services.AaaUser / AaaClient",
      "validation": "pkt_core.audit.validate_lab -> duplicate-aaa-client/-user"
    },
    "tftp": {
      "xml_structure": {
        "block": "ENGINE/TFTP_SERVER",
        "server_skeleton": {
          "TFTP_SERVER": {
            "ENABLED": "1"
          }
        }
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": null,
      "validation": null
    },
    "ntp": {
      "xml_structure": {
        "block": "ENGINE/NTP_SERVER",
        "server_skeleton": {
          "NTP_SERVER": {
            "ENABLED": "1",
            "ENABLED_SERVER_AUTHENTICATE": "0",
            "KEY": "0",
            "MD5PASSWORD": ""
          }
        }
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": null,
      "validation": null
    },
    "syslog": {
      "xml_structure": {
        "block": "ENGINE/SYSLOG_SERVER",
        "server_skeleton": {
          "SYSLOG_SERVER": {
            "ENABLED": "1"
          }
        }
      },
      "builder_api_method": null,
      "requires_direct_xml": true,
      "typed_read_view": null,
      "validation": null
    }
  }
}